{#-
  automap-sync usage (JMWE for Jira Cloud) - push this month's automation usage and the
  audit log to Automation Map (BETA, Advanced edition), as a Scheduled action of its own,
  next to automap-sync.njk, which pushes the rules.

  A Nunjucks template for JMWE's "Build-your-own (scripted) post-function", run by a
  Scheduled action whose JQL matches ONE anchor work item (e.g. key = OPS-1). A usage push
  spends no load of the map, so run it every hour: each run reads only yesterday and today
  (RUNS_DAYS = 1), which fits a JMWE action on any site, and the map keeps 35 days. Fill the same five values as in automap-sync.njk.

  Reads this month's steps, Rovo credits and flow runs per rule, and the audit log of the
  last RUNS_DAYS days folded into per-rule, per-day counts, from the internal API behind
  Jira's Usage and Audit log tabs, and pushes them as two separate pushes, each proven by
  X-Automap-Length. That API is undocumented and can change: a failure there is reported
  in the result line. No account ids, no issue ids and no message text leave. Each push is
  one chunk of at most 80 000 characters, so on a very large site only the busiest rules
  are kept. Set USAGE or RUNS to false to leave either out; if the audit log has more than
  RUNS_MAX_PAGES pages of 50, the runs are left out rather than sent in part - set
  RUNS_DAYS lower.

  Every request is tried up to three times when it gets no answer (a timeout), a 429 or
  a 5xx - at once, since a template cannot wait. A real 429 (the receiver's window of 500
  requests in 10 minutes used up) lasts minutes, so the three tries can go in a second
  and the job then fails for that run; the next scheduled run pushes again. The audit log is read up to the instant
  the window ends (toTime), so runs landing meanwhile shift no page. A 409 to a last
  chunk sent again means the receiver took the first copy and its answer was lost: the
  push is done.

  The rendered output is one line saying what happened; it lands in JMWE's logs.

  Copyright MOY Apps. Licensed for use with Automation Map for Jira only; see LICENSE.
-#}
{%- set SITE = "your-site.atlassian.net" -%}
{%- set EMAIL = "you@example.com" -%}
{%- set TOKEN = "an API token with the Automation scope" -%}
{%- set PUSH_URL = "the receiver URL from Automation Map, ending /v1/push" -%}
{%- set KEY = "the amk_ key from Automation Map" -%}
{%- set USAGE = true -%}
{%- set RUNS = true -%}
{%- set RUNS_DAYS = 1 -%}
{%- set RUNS_MAX_PAGES = 60 -%}


{%- set NAME = "jmwe" -%}
{%- set VERSION = "1.5.0" -%}
{%- set OPTS = { "auth": { "username": EMAIL, "password": TOKEN }, "timeout": 60000 } -%}
{%- set tenant = ("https://" + SITE + "/_edge/tenant_info") | callRest -%}
{%- set failures = [] -%}

{#- callRest with up to three tries: no answer (a timeout gives _error and no _statusCode),
    a 429 or a 5xx is tried again at once. The answer lands in `box` as [answer, tries - 1]:
    a macro renders text, so it hands objects back through an array. `how` is "get" (with
    the token), "post" (a JSON body, with the token) or "push" (text, with `opts` as given) -#}
{%- macro fetch(box, url, how, body, opts) -%}
{%- for tr in range(0, 3) -%}
  {%- if tr < 3 and not box.length -%}
    {%- if how == "push" -%}
      {%- set r = url | callRest(verb="post", body=body, noJSON=true, dontFail=true, options=opts) -%}
    {%- elif how == "post" -%}
      {%- set r = url | callRest(verb="post", body=body, options=OPTS, dontFail=true) -%}
    {%- else -%}
      {%- set r = url | callRest(options=OPTS, dontFail=true) -%}
    {%- endif -%}
    {%- if not (r._error or r._statusCode) or (r._statusCode and r._statusCode != 429 and r._statusCode < 500) or tr == 2 -%}
      {%- set _ = box.push(r) -%}
      {%- set _ = box.push(tr) -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- a GET of the internal API through fetch, as a value: the answer, or the object carrying _error -#}
{%- macro get(box, path) -%}{%- set _ = fetch(box, INTERNAL + path, "get") -%}{%- endmacro -%}

{#- usage and runs (BETA): the internal API behind Jira's Usage and Audit log tabs -#}
{%- macro ymd(days) -%}
{%- set z = days + 719468 -%}
{%- set era = z // 146097 -%}
{%- set doe = z - era * 146097 -%}
{%- set yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365 -%}
{%- set doy = doe - (365 * yoe + yoe // 4 - yoe // 100) -%}
{%- set mp = (5 * doy + 2) // 153 -%}
{%- set dd = doy - (153 * mp + 2) // 5 + 1 -%}
{%- set mm = (mp + 3) if mp < 10 else (mp - 9) -%}
{%- set yy = yoe + era * 400 + (1 if mm <= 2 else 0) -%}
{{- yy }}-{{ ("0" if mm < 10 else "") + mm }}-{{ ("0" if dd < 10 else "") + dd -}}
{%- endmacro -%}
{%- set notes = [] -%}
{%- set shut = false -%}
{%- set closed = [] -%}
{%- set INTERNAL = "https://api.atlassian.com/automation/internal-api/jira/" + tenant.cloudId + "/pro/rest/GLOBAL/" -%}
{%- set nowMs = (now | date("x")) | int -%}
{%- set dayNow = nowMs // 86400000 -%}
{%- set CHUNK_CHARS = 80000 -%}
{#- usage or runs, in chunks of CHUNK_CHARS like the rules (at most 240 KB of UTF-8 each), never
    split inside a surrogate pair, the whole proven by its length on the last one; answers
    "" or the first refusal, "HTTP <code>" -#}
{%- macro pushKind(kind, body) -%}
{%- set bounds = [0] -%}
{%- for bi in range(0, (body.length // CHUNK_CHARS) + 2) -%}
  {%- set st = bounds[bounds.length - 1] -%}
  {%- if st < body.length -%}
    {%- set en = (st + CHUNK_CHARS) if (st + CHUNK_CHARS) < body.length else body.length -%}
    {%- set cc = body.charCodeAt(en - 1) -%}
    {%- set en = (en - 1) if (en < body.length and cc >= 55296 and cc <= 56319) else en -%}
    {%- set _ = bounds.push(en) -%}
  {%- endif -%}
{%- endfor -%}
{%- set n = bounds.length - 1 -%}
{%- set krun = NAME + "-" + kind + "-" + body.length + "-" + nowMs -%}
{%- set bad = [] -%}
{%- for ci in range(0, n) -%}
  {%- if ci < n and not bad.length -%}
    {%- set hdr = { "Authorization": "Bearer " + KEY, "Content-Type": "text/plain; charset=utf-8", "X-Automap-Run": krun,
        "X-Automap-Seq": "" + ci, "X-Automap-Sender": NAME + "/" + VERSION, "X-Automap-Kind": kind } -%}
    {%- if ci == n - 1 -%}
      {%- set hdr = { "Authorization": "Bearer " + KEY, "Content-Type": "text/plain; charset=utf-8", "X-Automap-Run": krun,
          "X-Automap-Seq": "" + ci, "X-Automap-Sender": NAME + "/" + VERSION, "X-Automap-Kind": kind,
          "X-Automap-Last": "1", "X-Automap-Length": "" + body.length } -%}
    {%- endif -%}
    {%- set box = [] -%}
    {%- set _ = fetch(box, PUSH_URL, "push", body.slice(bounds[ci], bounds[ci + 1]), { "headers": hdr, "timeout": 60000 }) -%}
    {%- set res = box[0] -%}
    {#- a 409 to the last chunk sent again: the first copy was taken, its answer lost - the push is done -#}
    {%- if res._statusCode == 409 and box[1] > 0 and ci == n - 1 -%}
    {%- elif res._statusCode or res._error -%}{%- set _ = bad.push(("HTTP " + res._statusCode) if res._statusCode else "no answer") -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- bad[0] if bad.length else "" -}}
{%- endmacro -%}

{%- if USAGE and not shut -%}
  {%- set today = ymd(dayNow) | trim -%}
  {%- set firstDay = dayNow - (today.slice(8, 10) | int) + 1 -%}
  {%- set periods = [] -%}
  {#- this month so far; and in its first three days the whole of the month before -#}
  {%- if (today.slice(8, 10) | int) <= 3 -%}
    {%- set prevLast = ymd(firstDay - 1) | trim -%}
    {%- set _ = periods.push([(firstDay - (prevLast.slice(8, 10) | int)) * 86400000, firstDay * 86400000 - 1, prevLast.slice(0, 7)]) -%}
  {%- endif -%}
  {%- set _ = periods.push([firstDay * 86400000, nowMs, today.slice(0, 7)]) -%}
  {%- set uStop = [] -%}
  {%- for pi in range(0, periods.length) -%}
    {%- if pi < periods.length and not uStop.length -%}
      {%- set pd = periods[pi] -%}
      {%- set q = "startTime=" + pd[0] + "&endTime=" + pd[1] -%}
      {%- set cbox = [] -%}{%- set _ = get(cbox, "creditUsage?" + q) -%}{%- set credit = cbox[0] -%}
      {%- if credit._statusCode or credit._error -%}
        {%- set _ = uStop.push("usage (beta) skipped: creditUsage answered " + (credit._statusCode or "nothing")) -%}
      {%- else -%}
        {%- set fKeys = [] -%}
        {%- set flows = [] -%}
        {%- set bad = [] -%}
        {#- sortBy also filters to rules with that metric above zero: read both and merge -#}
        {%- for sortBy in ["automationCredits", "rovoCredits"] -%}
          {%- set seenN = [0] -%}
          {%- set done = [] -%}
          {%- for page in range(0, 100) -%}
            {%- if page < 100 and not done.length and not bad.length -%}
              {%- set fbox = [] -%}{%- set _ = get(fbox, "highUsageFlows?limit=100&page=" + page + "&sortBy=" + sortBy + "&" + q) -%}{%- set r = fbox[0] -%}
              {%- if r._statusCode or r._error -%}
                {%- set _ = bad.push("highUsageFlows answered " + (r._statusCode or "nothing")) -%}
              {%- else -%}
                {%- set got = r.flows or [] -%}
                {%- for f in got -%}
                  {%- if f.ruleUuid -%}
                    {%- set row = { "uuid": f.ruleUuid, "name": f.ruleName or "", "state": f.state or "ENABLED", "runs": f.runs or 0,
                                    "steps": f.automationCredits or 0, "rovo": f.rovoCredits or 0,
                                    "deleted": true if f.deleted else false, "agentic": true if f.containsAgentic else false } -%}
                    {%- set at = fKeys.indexOf(f.ruleUuid) -%}
                    {%- if at < 0 -%}
                      {%- set _ = fKeys.push(f.ruleUuid) -%}
                      {%- set _ = flows.push(row) -%}
                    {%- else -%}
                      {%- set _ = flows.splice(at, 1, row) -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- set _ = seenN.splice(0, 1, seenN[0] + got.length) -%}
                {%- if got.length == 0 or seenN[0] >= (r.totalCount or 0) -%}{%- set _ = done.push(1) -%}{%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- if bad.length -%}
          {%- set _ = uStop.push("usage (beta) skipped: " + bad[0]) -%}
        {%- else -%}
          {#- the rest is the current billing model, and the least stable part: each piece optional -#}
          {%- set tbox = [] -%}{%- set _ = get(tbox, "highestUsages?limit=100&month=" + pd[2]) -%}{%- set top = tbox[0] -%}
          {%- set bill = [] -%}
          {%- if not top._statusCode and not top._error and top.length is defined -%}
            {%- for t in top -%}{%- if t.ruleIdUuid -%}{%- set _ = bill.push({ "uuid": t.ruleIdUuid, "runs": t.executionCount or 0 }) -%}{%- endif -%}{%- endfor -%}
          {%- endif -%}
          {%- set xbox = [] -%}{%- set _ = get(xbox, "pagecontext") -%}{%- set ctx = xbox[0] -%}
          {%- set lims = [] -%}
          {%- if not ctx._statusCode and not ctx._error and ctx.tenantPageContext and ctx.tenantPageContext.usage and ctx.tenantPageContext.usage.workspaceUsages -%}
            {%- for k, v in ctx.tenantPageContext.usage.workspaceUsages -%}
              {%- set _ = lims.push({ "product": k, "used": v.executionsUsed or 0, "limit": v.executionLimit or 0, "edition": v.edition or "" }) -%}
            {%- endfor -%}
          {%- endif -%}
          {%- set rbox = [] -%}{%- set _ = get(rbox, "usageTrendData") -%}{%- set tr = rbox[0] -%}
          {%- set trend = [] -%}
          {%- if not tr._statusCode and not tr._error and tr.data -%}
            {%- for t in tr.data -%}{%- set _ = trend.push({ "month": t.month, "runs": t.workspaceCounts or {} }) -%}{%- endfor -%}
          {%- endif -%}
          {%- set pbox = [] -%}{%- set _ = get(pbox, "hasCreditPack") -%}{%- set pack = pbox[0] -%}
          {%- set ca = credit.automation or {} -%}
          {%- set cr = credit.rovo or {} -%}
          {%- set head = '{"period":' + ({ "start": pd[0], "end": pd[1] } | dump)
              + ',"steps":' + ({ "total": ca.total or 0, "jira": ca.currentProduct or 0, "other": ca.everywhereElse or 0 } | dump)
              + ',"rovo":' + ({ "total": cr.total or 0, "jira": cr.currentProduct or 0, "other": cr.everywhereElse or 0 } | dump) -%}
          {%- set tail = ((',"billable":' + ({ "month": pd[2], "rules": bill } | dump)) if (not top._statusCode and not top._error) else "")
              + ((',"limits":' + (lims | dump)) if lims.length else "")
              + ((',"trend":' + (trend | dump)) if (not tr._statusCode and not tr._error and tr.data) else "")
              + ((',"creditPack":' + ("true" if pack.hasCreditPack else "false")) if (not pack._statusCode and not pack._error) else "") -%}
          {%- set doc = '{"usage":' + head + ',"flows":' + (flows | dump) + tail + '},"sender":{"name":"' + NAME + '","version":"' + VERSION + '"}}' -%}
          {%- set said = "" + (pushKind("usage", doc) | trim) -%}
          {%- if said.indexOf("HTTP 403") == 0 -%}{%- set _ = closed.push(1) -%}{%- endif -%}
          {%- set _ = notes.push(("usage (beta) " + pd[2] + ": not taken, receiver answered " + said) if said else ("usage (beta) " + pd[2] + ": pushed " + (ca.total or 0) + " steps for " + flows.length + " rules")) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if uStop.length -%}{%- set _ = notes.push(uStop[0]) -%}{%- endif -%}
{%- endif -%}

{%- if RUNS and closed.length -%}
  {%- set _ = notes.push("runs (beta) skipped: the map does not take them (403)") -%}
{%- endif -%}
{#- an instant as ISO 8601 with milliseconds and Z, from Unix ms, without a date library -#}
{%- macro iso(ms) -%}
{%- set rest = ms % 86400000 -%}
{%- set hh = rest // 3600000 -%}{%- set mi = (rest % 3600000) // 60000 -%}{%- set ss = (rest % 60000) // 1000 -%}{%- set ml = rest % 1000 -%}
{{- ymd(ms // 86400000) | trim }}T{{ ("0" if hh < 10 else "") + hh }}:{{ ("0" if mi < 10 else "") + mi }}:{{ ("0" if ss < 10 else "") + ss }}.{{ ("00" if ml < 10 else ("0" if ml < 100 else "")) + ml }}Z
{%- endmacro -%}
{%- if RUNS and not shut and not closed.length -%}
  {%- set days = (RUNS_DAYS if RUNS_DAYS >= 1 else 1) if RUNS_DAYS <= 30 else 30 -%}
  {%- set startDay = dayNow - days -%}
  {%- set startMs = startDay * 86400000 -%}
  {#- the log is newest first and paged by offset: runs landing while it is read would
      shift every page, so the read ends at the instant the window does (toTime) -#}
  {#- a macro's output is a SafeString: "" + makes it the plain text the API gets -#}
  {%- set window = { "fromTime": (ymd(startDay) | trim) + "T00:00:00.000Z", "toTime": "" + (iso(nowMs) | trim) } -%}
  {%- set rStop = [] -%}
  {%- set records = [] -%}
  {%- set more = [1] -%}
  {#- 50 a page whatever is asked; `total` is always 0 -#}
  {%- for pg in range(0, RUNS_MAX_PAGES + 1) -%}
    {%- if more.length and not rStop.length -%}
      {%- if pg >= RUNS_MAX_PAGES -%}
        {%- set _ = rStop.push("runs (beta) skipped: the audit log of " + days + " days is longer than " + RUNS_MAX_PAGES + " pages; set RUNS_DAYS lower") -%}
      {%- else -%}
        {%- set abox = [] -%}
        {%- set _ = fetch(abox, INTERNAL + "auditlog", "post", { "fromTime": window.fromTime, "toTime": window.toTime, "offset": pg * 50, "limit": 50 }) -%}
        {%- set a = abox[0] -%}
        {%- if a._statusCode or a._error -%}
          {%- set _ = rStop.push("runs (beta) skipped: auditlog answered " + (a._statusCode or "nothing")) -%}
        {%- else -%}
          {%- set got = (a.items.items if a.items else []) or [] -%}
          {%- for x in got -%}{%- set _ = records.push(x) -%}{%- endfor -%}
          {%- if got.length < 50 -%}{%- set _ = more.pop() -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if rStop.length -%}
    {%- set _ = notes.push(rStop[0]) -%}
  {%- else -%}
    {#- per rule and UTC day; counters live in arrays, the one thing a template may change -#}
    {%- set keys = [] -%}{%- set meta = [] -%}
    {%- set cSucc = [] -%}{%- set cErr = [] -%}{%- set cNoop = [] -%}{%- set cEdit = [] -%}{%- set cMs = [] -%}{%- set cMax = [] -%}
    {%- set cHour = [] -%}
    {%- set failed = [] -%}
    {%- for r in records -%}
      {%- set t = r.eventTimestamp or r.startTime -%}
      {%- if r.ruleIdUuid and t and t >= startMs -%}
        {%- set day = ymd(t // 86400000) | trim -%}
        {%- set k = r.ruleIdUuid + "|" + day -%}
        {%- set at = keys.indexOf(k) -%}
        {%- if at < 0 -%}
          {%- set _ = keys.push(k) -%}
          {%- set _ = meta.push({ "uuid": r.ruleIdUuid, "day": day, "name": r.ruleName or "" }) -%}
          {%- set _ = cSucc.push(0) -%}{%- set _ = cErr.push(0) -%}{%- set _ = cNoop.push(0) -%}{%- set _ = cEdit.push(0) -%}{%- set _ = cMs.push(0) -%}{%- set _ = cMax.push(0) -%}
          {%- for h in range(0, 24) -%}{%- if h < 24 -%}{%- set _ = cHour.push(0) -%}{%- endif -%}{%- endfor -%}
          {%- set at = keys.length - 1 -%}
        {%- endif -%}
        {%- if r.category == "CONFIG_CHANGE" -%}
          {%- set _ = cEdit.splice(at, 1, cEdit[at] + 1) -%}
        {%- else -%}
          {%- if r.category == "SUCCESS" -%}{%- set _ = cSucc.splice(at, 1, cSucc[at] + 1) -%}
          {%- elif r.category == "NO_ACTIONS_PERFORMED" -%}{%- set _ = cNoop.splice(at, 1, cNoop[at] + 1) -%}
          {%- else -%}{%- set _ = cErr.splice(at, 1, cErr[at] + 1) -%}
            {%- if r.id -%}{%- set _ = failed.push({ "uuid": r.ruleIdUuid, "id": r.id, "at": r.eventTimestamp or 0 }) -%}{%- endif -%}
          {%- endif -%}
          {%- set hi = at * 24 + ((t % 86400000) // 3600000) -%}
          {%- set _ = cHour.splice(hi, 1, cHour[hi] + 1) -%}
          {%- set _ = cMs.splice(at, 1, cMs[at] + (r.durationMs or 0)) -%}
          {%- if (r.durationMs or 0) > cMax[at] -%}{%- set _ = cMax.splice(at, 1, r.durationMs) -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {#- the failing component and the error code of up to two failed runs a rule, 40 in all -#}
    {%- set errs = [] -%}
    {%- set perRule = [] -%}
    {%- set spent = [] -%}
    {%- for f in (failed | sort(true, false, "at")) -%}
      {%- if spent.length < 40 and (perRule | select("equalto", f.uuid) | list | length) < 2 -%}
        {%- set _ = perRule.push(f.uuid) -%}
        {%- set _ = spent.push(1) -%}
        {%- set dbox = [] -%}{%- set _ = get(dbox, "auditlog/item/" + f.id) -%}{%- set d = dbox[0] -%}
        {%- if not d._statusCode and not d._error and d.content -%}
          {%- for cl in (d.content.componentLogs or []) -%}
            {%- set res = cl.executionResult or {} -%}
            {%- set ek = [] -%}
            {%- for ch in (cl.changes or []) -%}{%- if ch.payload and ch.payload.type == "ERROR" and not ek.length -%}{%- set _ = ek.push(ch.payload.key or "") -%}{%- endif -%}{%- endfor -%}
            {%- set code = (ek[0] if ek.length else "") or res.auditEventErrorType or res.errorType or "" -%}
            {%- if code or res.state == "SOME_ERRORS" -%}
              {%- set comp = cl.component or {} -%}
              {%- set _ = errs.push({ "uuid": f.uuid, "componentId": comp.id or "", "componentType": comp.componentType or "",
                                      "type": comp.type or "", "code": code or "SOME_ERRORS", "at": f.at }) -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {#- rows as JSON, the busiest first -#}
    {%- set order = [] -%}
    {%- for i in range(0, keys.length) -%}{%- if i < keys.length -%}{%- set _ = order.push({ "i": i, "n": cSucc[i] + cErr[i] + cNoop[i] }) -%}{%- endif -%}{%- endfor -%}
    {%- set rowsJson = [] -%}
    {%- set totals = [0, 0] -%}
    {%- for o in (order | sort(true, false, "n")) -%}
      {%- set i = o.i -%}
      {%- set hp = [] -%}
      {%- for h in range(0, 24) -%}{%- if h < 24 and cHour[i * 24 + h] -%}{%- set _ = hp.push('"' + h + '":' + cHour[i * 24 + h]) -%}{%- endif -%}{%- endfor -%}
      {%- set one = '{"uuid":' + (meta[i].uuid | dump) + ',"day":"' + meta[i].day + '","name":' + (meta[i].name | dump)
          + ',"success":' + cSucc[i] + ',"errors":' + cErr[i] + ',"noop":' + cNoop[i] + ',"edits":' + cEdit[i]
          + ',"ms":' + cMs[i] + ',"maxMs":' + cMax[i] + (',"hours":{' + hp.join(",") + '}' if hp.length else "") + '}' -%}
      {%- set _ = rowsJson.push(one) -%}
      {%- set _ = totals.splice(0, 2, totals[0] + o.n, totals[1] + cErr[i]) -%}
    {%- endfor -%}
    {%- set doc = '{"runs":{"window":' + ({ "start": startMs, "end": nowMs } | dump) + ',"rows":[' + rowsJson.join(",") + '],"errors":' + (errs | dump)
        + '},"sender":{"name":"' + NAME + '","version":"' + VERSION + '"}}' -%}
    {%- set said = "" + (pushKind("runs", doc) | trim) -%}
    {%- set _ = notes.push(("runs (beta): not taken, receiver answered " + said) if said else ("runs (beta) " + ("yesterday and today" if days == 1 else "last " + days + " days") + ": pushed " + totals[0] + " runs, " + totals[1] + " with errors")) -%}
